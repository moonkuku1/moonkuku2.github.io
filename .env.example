NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SHOW_DRAFT=true
DATA_GO_KR_KEY=

# AI 문장 생성 (서버에서만 읽음). 키가 없으면 샘플 문장 모드로 동작한다.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# 결제 연결 전에는 AI가 켜져 있을 때 test로 둬야 답이 나온다. 결제 검증을 붙이면 이 값은 없앤다.
PAYMENT_MODE=

# 답변 생성이 두 번 실패했을 때 알림을 받을 주소(선택)
OPERATOR_WEBHOOK_URL=

# 캐시 키에 섞는 비밀 값(길고 무작위로). 저장소를 DB로 바꿀 때는 꼭 정해 둔다.
CACHE_HASH_SECRET=

# AI 하루 호출 한도(기본 300). AI 회사 콘솔의 월 사용 한도도 꼭 함께 건다.
LLM_DAILY_CAP=
